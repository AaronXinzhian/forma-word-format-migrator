<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WindowsPackDeletionPolicyTests</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 回收站 API 在 Microsoft.VisualBasic.FileIO，随桌面框架一起引用。 -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!--
    直接编译被测源文件而不是 ProjectReference：PackDeletionPolicy 与 PackManifest 都是
    internal，跨程序集引用还得额外开 InternalsVisibleTo，把本可以内聚的可见性撑开。
  -->
  <ItemGroup>
    <Compile Include="../../windows-app/FormaFushi.Windows/PackDeletionPolicy.cs" />
    <Compile Include="../../windows-app/FormaFushi.Windows/Models.cs" />
    <Compile Include="../../windows-app/FormaFushi.Windows/Generated/UIStrings.g.cs" />
  </ItemGroup>
</Project>
